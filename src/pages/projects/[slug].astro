---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import { projects, type Project } from '../../data/projects';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;

const details = [
  { label: 'Location', value: project.location },
  { label: 'Scope', value: project.scope ?? '[Scope]' },
  { label: 'Completed', value: project.year ?? '[Year]' },
  { label: 'Photography', value: project.photographer ?? '[Photographer]' },
];
const intro = project.intro ?? '[One-line project story.]';
const body = project.body ?? ['[Project write-up.]'];
const gallery = project.gallery ?? [
  { alt: '[Alt text]', caption: '[Room]', tone: '#B9AC98' },
  { alt: '[Alt text]', caption: '[Room]', tone: '#5A4C3F' },
  { alt: '[Alt text]', caption: '[Room]', tone: '#3E3833' },
];
const [first, second, ...rest] = gallery;
---
<Base title={project.title} current="Work" description={`${project.title} — ${project.location}. Interior design by Valerie Grant Interiors.`}>
  <section class="container-site flex flex-wrap items-end justify-between gap-12 pt-16 pb-16 md:pt-20">
    <div class="flex min-w-0 flex-[1_1_560px] flex-col gap-5">
      <a href={url('/projects/')} class="caps hover:text-primary"><span aria-hidden="true">← </span>All work</a>
      <h1 class="font-display text-[clamp(44px,6vw,88px)] leading-none">{project.title}</h1>
    </div>
    <dl class="grid flex-[0_1_380px] grid-cols-2 gap-x-8 gap-y-5 text-[15px]">
      {details.map((d) => (
        <div>
          <dt class="caps mb-1.5 text-[11px] text-muted">{d.label}</dt>
          <dd>{d.value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="container-site">
    <Photo photo={project.cover} class="h-[56vh] min-h-[420px] md:h-[720px]" eager />
  </section>

  <section class="container-site flex flex-wrap gap-16 py-28">
    <p class="min-w-0 flex-[1_1_380px] font-display text-[28px] italic leading-[1.35]">{intro}</p>
    <div class="flex min-w-0 flex-[1_1_480px] flex-col gap-5 text-lg leading-[1.7]">
      {body.map((para) => <p>{para}</p>)}
    </div>
  </section>

  <section class="container-site flex flex-col gap-10 pb-28" aria-label="Gallery">
    <div class="grid gap-10 md:grid-cols-2">
      {first && (
        <figure class="flex flex-col gap-3">
          <Photo photo={first} ratio="4 / 5" />
          {first.caption && <figcaption class="caps text-muted">{first.caption}</figcaption>}
        </figure>
      )}
      {second && (
        <figure class="flex flex-col gap-3 md:mt-28">
          <Photo photo={second} ratio="4 / 5" />
          {second.caption && <figcaption class="caps text-muted">{second.caption}</figcaption>}
        </figure>
      )}
    </div>
    {rest.map((photo) => (
      <figure class="flex flex-col gap-3">
        <Photo photo={photo} ratio="2 / 1" />
        {photo.caption && <figcaption class="caps text-muted">{photo.caption}</figcaption>}
      </figure>
    ))}
  </section>

  {project.quote && (
    <section class="bg-neutral text-neutral-content" aria-label="Client review">
      <figure class="mx-auto flex max-w-[1000px] flex-col items-center gap-7 px-5 py-28 text-center md:px-10">
        <span aria-hidden="true" class="font-display text-6xl leading-[0.5] text-secondary">“</span>
        <blockquote class="font-display text-[clamp(26px,3vw,40px)] leading-[1.3]">{project.quote.text}</blockquote>
        <figcaption class="caps text-muted-dark">{project.quote.by}</figcaption>
      </figure>
    </section>
  )}

  <section class="container-site flex flex-wrap items-center justify-between gap-8 py-24">
    <a href={url(`/projects/${next.slug}/`)} class="font-display text-[clamp(28px,3vw,40px)] hover:text-primary">
      Next: {next.title} <span aria-hidden="true">→</span>
    </a>
    <a href={url('/#inquire')} class="btn btn-primary caps h-14 px-8">Start an inquiry</a>
  </section>
</Base>
